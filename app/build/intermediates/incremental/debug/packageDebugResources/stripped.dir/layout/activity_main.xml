<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Fluid Moving Violet/Blue Gradient Background -->
    <com.airplay.tv.ui.MovingGradientView
        android:id="@+id/movingGradientBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- AirPlay Hardware Video Surface View -->
    <SurfaceView
        android:id="@+id/videoSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Frosted Glass TV Dashboard Overlay -->
    <LinearLayout
        android:id="@+id/dashboardOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="visible">

        <!-- Top Header with Frosted Logo and App Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Frosted Glass App Icon -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_512" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/ubuntu"
                    android:text="@string/app_tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Frosted Status Badge -->
            <LinearLayout
                android:id="@+id/badgeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_badge"
                android:gravity="center_vertical"
                android:paddingHorizontal="22dp"
                android:paddingVertical="10dp">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/glass_card"
                    android:backgroundTint="@color/status_green" />

                <TextView
                    android:id="@+id/txtStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/ubuntu"
                    android:text="ONLINE &amp; READY"
                    android:textColor="@color/status_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3 Frosted Glass Columns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Card 1: Receiver Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="RECEIVER CONFIG"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/ubuntu"
                    android:text="@string/lbl_device_name"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="BloomAir TV"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/ubuntu"
                    android:text="@string/lbl_ip_address"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtIpAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="192.168.1.199"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/ubuntu"
                    android:text="@string/lbl_port"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtPort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="7000 (RTSP) / 7001 (RAOP)"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Card 2: Low Latency Engine Stats -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="SPEED &amp; LATENCY ENGINE"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/ubuntu"
                    android:text="Connected Device:"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtSenderDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="Waiting for connection..."
                    android:textColor="@color/status_yellow"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/ubuntu"
                    android:text="Display Pipeline:"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="1080p60 • Zero-Copy Surface"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/ubuntu"
                    android:text="Network Buffer:"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtAudioStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="TCP_NODELAY • &lt; 40ms sync"
                    android:textColor="@color/status_green"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 3: Apple Connection Steps -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu"
                    android:text="HOW TO CAST"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/ubuntu"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/step_1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/ubuntu"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/step_2"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/ubuntu"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/step_3"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- TV Remote D-Pad Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggleServer"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:background="@drawable/glass_button_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/ubuntu"
                android:minWidth="180dp"
                android:text="@string/btn_stop"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRenameTV"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/glass_button_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/ubuntu"
                android:minWidth="180dp"
                android:text="@string/btn_rename"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/glass_button_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/ubuntu"
                android:minWidth="180dp"
                android:text="@string/btn_switch_video"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
