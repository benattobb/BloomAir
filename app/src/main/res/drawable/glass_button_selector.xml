<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state for TV Remote -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#9067F6"
                android:endColor="#3B82F6"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2.5dp"
                android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#6D28D9"
                android:endColor="#1D4ED8"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_border" />
        </shape>
    </item>

    <!-- Default frosted glass state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#7C3AED"
                android:endColor="#2563EB"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
</selector>
