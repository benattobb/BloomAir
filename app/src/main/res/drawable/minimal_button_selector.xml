<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state for TV Remote D-Pad: Inverted pure white with crisp outline -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_bg_focused" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_bg_pressed" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Default state: Matte dark iron button -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_bg_normal" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/btn_border_normal" />
        </shape>
    </item>
</selector>
