<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- AirPlay Hardware Video Surface View (Hardware zero-copy) -->
    <SurfaceView
        android:id="@+id/videoSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- Minimal TV Front Dashboard Overlay -->
    <LinearLayout
        android:id="@+id/dashboardOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="48dp"
        android:paddingEnd="64dp"
        android:paddingBottom="48dp"
        android:visibility="visible">

        <!-- Top Minimal Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Sage & Dark Iron Blossom Icon -->
            <ImageView
                android:id="@+id/imgAppLogo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_bloomair_512" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_bold"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="AirPlay Receiver"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Minimal Status Pill Badge -->
            <LinearLayout
                android:id="@+id/statusBadgeContainer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/minimal_badge"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="18dp">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/minimal_dot"
                    android:backgroundTint="@color/status_ready" />

                <TextView
                    android:id="@+id/txtStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:letterSpacing="0.05"
                    android:text="READY TO CONNECT"
                    android:textColor="@color/accent_sage"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Center Stage: The Basics Only -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/minimal_card"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingTop="36dp"
            android:paddingEnd="44dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_medium"
                android:letterSpacing="0.12"
                android:text="AIRPLAY RECEIVER"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/ubuntu_bold"
                android:text="BloomAir TV"
                android:textColor="@color/text_primary"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/txtInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/ubuntu_regular"
                android:lineSpacingExtra="4dp"
                android:text="Open Control Center on your iPhone, iPad, or Mac, select Screen Mirroring, and choose BloomAir TV."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <!-- Device Connection Status Line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="Device Status: "
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtSenderDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:text="Waiting for connection"
                    android:textColor="@color/accent_sage"
                    android:textSize="13sp" />

                <com.airplay.tv.ui.RunningDotsView
                    android:id="@+id/runningDotsView"
                    android:layout_width="36dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Actions (Basics Only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggleServer"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/minimal_button_selector"
                android:focusable="true"
                android:fontFamily="@font/ubuntu_medium"
                android:nextFocusRight="@id/btnSettings"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Stop Receiver"
                android:textAllCaps="false"
                android:textColor="@color/minimal_button_text_selector"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/minimal_button_selector"
                android:focusable="true"
                android:fontFamily="@font/ubuntu_medium"
                android:nextFocusLeft="@id/btnToggleServer"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Settings &amp; Details"
                android:textAllCaps="false"
                android:textColor="@color/minimal_button_text_selector"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
